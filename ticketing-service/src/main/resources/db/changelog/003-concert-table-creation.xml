<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-concert-table-creation" author="patryk-ktl">
        <createTable tableName="concert">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_concert_event"
                             references="event(id)"
                             deleteCascade="true"/>
            </column>
            <column name="artist" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="genre" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="support_act" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="concert"/>
        </rollback>
    </changeSet>
</databaseChangeLog>