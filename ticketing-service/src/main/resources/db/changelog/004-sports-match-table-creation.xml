<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-sports-match-table-creation" author="patryk-ktl">
        <createTable tableName="sports_match">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_sports_match_event"
                             references="event(id)"
                             deleteCascade="true"/>
            </column>
            <column name="home_team" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="away_team" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="league" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="sports_match"/>
        </rollback>
    </changeSet>
</databaseChangeLog>