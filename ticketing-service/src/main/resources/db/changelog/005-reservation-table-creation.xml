<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-reservation-table-creation" author="patryk-ktl">
        <createTable tableName="reservation">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_reservation_event"
                             references="event(id)"/>
            </column>
            <column name="customer_email" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="seats" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="NUMERIC(10, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="hold_expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="reservation"/>
        </rollback>
    </changeSet>
</databaseChangeLog>